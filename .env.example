# Copy this file to `.env` and fill in real values.
# The app refuses to boot if any DB_* or JWT_SECRET value below is missing.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=to-do-api-project

# Set to true for hosted Postgres that requires TLS (e.g. Neon).
DB_SSL=false

# HTTP port the API listens on (optional, defaults to 3000)
PORT=3000

# Secret used to sign the JWT issued on sign-in.
# Generate a real one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Anyone holding this can mint valid tokens, so never commit the real value.
JWT_SECRET=
# Token lifetime, e.g. 15m, 24h, 7d (optional, defaults to 1h)
JWT_EXPIRES_IN=1h

# Cloudinary credentials, used to store profile images.
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Find them in the Cloudinary dashboard (Settings -> API Keys).
CLOUDINARY_URL=

# SMTP account used to send the forgot-password reset code (Gmail).
# For Gmail, create an App Password: Google Account -> Security ->
# 2-Step Verification -> App passwords, and put it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=